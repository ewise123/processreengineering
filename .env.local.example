# The app calls its backend through this server's /api proxy (next.config.ts),
# so no API URL is needed for local development — leave this file empty.
#
# Set NEXT_PUBLIC_API_URL only to bypass the proxy and point the browser
# directly at a backend, which is rarely what you want: it hardcodes a host into
# the browser bundle and breaks whenever the app is opened from anywhere other
# than that host.
# NEXT_PUBLIC_API_URL=http://localhost:8000

# Where this server forwards /api requests. Defaults to http://localhost:8000.
# API_PROXY_TARGET=http://localhost:8000
